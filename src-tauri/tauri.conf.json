{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Auto Clicker",
  "version": "0.1.5",
  "identifier": "kr.co.uulab.autoclicker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Auto Clicker",
        "width": 600,
        "height": 720,
        "minWidth": 480,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYzRjREMUE1ODkyMDczMUUKUldRZWN5Q0pwZEgwWXhOQ09sK1Rjd2p1WkhONnZOY0FMNERRZ3JZdVJCdm9LeW1QSUJVckFLaDAK",
      "endpoints": [
        "https://github.com/uulab-official/auto-clicker/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
